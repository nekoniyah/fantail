// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "sqlite"
}

model UserSettings {
  user       User    @relation(fields: [userId], references: [id])
  userId     String  @id
  showGore   Boolean @default(false)
  showNsfw   Boolean @default(false)
  showNudity Boolean @default(false)
}

model User {
  id       String  @id @default(cuid(2))
  username String
  password String
  admin    Boolean @default(false)

  verified Boolean @default(false)
  email    String?

  age Int?

  displayName   String?
  notifications Notification[]
  description   String?

  avatar Avatar?
  banner Banner?

  avatarUrl String?
  bannerUrl String?

  groups        Group[]
  groupMessages GroupMessage[]

  friendInvitations FriendInvitation[]

  friends         User[]           @relation("Friendship")
  friendOf        User[]           @relation("Friendship")
  trustedSessions TrustedSession[]
  sessions        Session[]

  publicKey        String? // base64 X25519 public key (nullable until each user has generated one)
  signingPublicKey String? // base64 Ed25519 public key (for sender authenticity)

  groupKeyEnvelopes     GroupKeyEnvelope[]
  userSettings          UserSettings?
  userSettingsUserId    String?            @unique

  media Media[]
}

// The group key, sealed to one member's public key, one row per (group, user, version)
model GroupKeyEnvelope {
  id         String @id @default(cuid(2))
  group      Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId    String
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  version    Int
  wrappedKey String // base64 crypto_box_seal output

  @@unique([groupId, userId, version])
  @@index([userId, groupId])
}

model Media {
  id             String        @id @default(cuid(2))
  type           String // "emote" | "sticker" | "attachment"
  data           String // plaintext for emote/sticker, base64 ciphertext for attachment
  format         String // real format for emote/sticker, constant "bin" for attachment
  nonce          String? // only set for "attachment"
  uploaderId     String? // lets you check ownership when attaching
  // Encrypted attachment ciphertexts die with their message; emote/sticker
  // rows are standalone library items and never join a message.
  groupMessage   GroupMessage? @relation(fields: [groupMessageId], references: [id], onDelete: Cascade)
  groupMessageId String? // only used for "attachment"
  sensitivity    String?

  // User library entries ("emote" / "sticker"): owned and named by their uploader
  name String?
  owner User? @relation(fields: [uploaderId], references: [id])

  @@index([uploaderId, type])
}

model Avatar {
  userId String @id
  user   User   @relation(fields: [userId], references: [id])
  data   String
  format String
}

model Banner {
  userId String @id
  user   User   @relation(fields: [userId], references: [id])
  data   String
  format String
}

model Notification {
  id      String  @id @default(cuid(2))
  user    User    @relation(fields: [userId], references: [id])
  userId  String
  message String
  event   String
  read    Boolean @default(false)
}

model Group {
  id      String  @id @default(cuid(2))
  ownerId String
  members User[]
  name    String?

  messages GroupMessage[]

  keyVersion Int @default(0) // 0 = no key yet

  envelopes GroupKeyEnvelope[]
}

model GroupMessage {
  id String @id @default(cuid(2))

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId String

  sender   User   @relation(fields: [senderId], references: [id])
  senderId String

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  attachments Media[]

  content    String // base64 ciphertext (never plaintext)
  nonce      String
  keyVersion Int
  signature  String? // Ed25519 signature over (groupId, senderId, keyVersion, nonce, content)
}

model FriendInvitation {
  id String @id @default(cuid(2))

  sender   User   @relation(fields: [senderId], references: [id])
  senderId String

  targetId String
}

model TrustedSession {
  id String @id @default(cuid(2))

  user   User   @relation(fields: [userId], references: [id])
  userId String

  identity  String
  createdAt DateTime @default(now())
  used      Boolean  @default(false)
}

model Session {
  id        String   @id @default(cuid(2))
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  token     String
  expiresAt DateTime
}
